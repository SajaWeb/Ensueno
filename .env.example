# Plantilla de variables de entorno. Copia este archivo como `.env.local` y
# rellena los valores reales. `.env.local` está ignorado por git a propósito:
# nunca debe subirse al repositorio.

# --- Base de datos -----------------------------------------------------------
DATABASE_URL="postgresql://usuario:contraseña@host:puerto/basededatos"

# --- Sesión ------------------------------------------------------------------
JWT_SECRET=""
NEXTAUTH_SECRET=""

# --- Sitio -------------------------------------------------------------------
# Sin barra final. MercadoPago rechaza back_urls con localhost.
NEXT_PUBLIC_APP_URL="https://ensueno.com.co"

# WhatsApp de atención, con indicativo de país.
# Se incrusta en el bundle del navegador (por eso el prefijo NEXT_PUBLIC_): es
# un dato público, el enlace wa.me lo necesita visible. Vive aquí para que no
# quede escrito en el código ni en el historial de git.
NEXT_PUBLIC_WHATSAPP_NUMBER="+57XXXXXXXXXX"

# --- Pagos: MercadoPago ------------------------------------------------------
# El token manda: TEST- son credenciales de prueba, APP_USR- son de producción.
# Con un token APP_USR- deja MERCADOPAGO_SANDBOX en false para que coincidan.
MERCADOPAGO_ACCESS_TOKEN=""
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=""
MERCADOPAGO_WEBHOOK_SECRET=""
MERCADOPAGO_SANDBOX="false"

# --- Correos: Resend ---------------------------------------------------------
# Sin RESEND_API_KEY el servicio entra en modo simulación y solo registra en
# consola, sin enviar nada.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Ensueño <no-responder@ensueno.com.co>"

# --- Analítica: Meta ---------------------------------------------------------
NEXT_PUBLIC_META_PIXEL_ID=""
META_CONVERSIONS_API_TOKEN=""

# --- Medusa (heredado) -------------------------------------------------------
MEDUSA_BACKEND_URL=""
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=""
